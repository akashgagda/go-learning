{
  "mcpServers": {
    "learn-go-with-tests": {
      "transport": "http",
      "enabled": true,
      "url": "https://quii.gitbook.io/learn-go-with-tests/~gitbook/mcp"
    },
    "gopls": {
      "transport": "stdio",
      "enabled": true,
      "command": "gopls",
      "args": ["mcp"]
    },
    "pkgsite": {
      "transport": "stdio",
      "enabled": true,
      "command": "pkgsite"
    }
  }
}
