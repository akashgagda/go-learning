# Obsidian: machine-specific UI state only; the rest of the vault config is backed up
notes/.obsidian/workspace.json

# Obsidian theme is generated by THPM/Omarchy; apply it yourself via thpm
notes/.obsidian/themes/

# Terminal plugin data.json contains the THPM-managed color palette; keep it out of git
notes/.obsidian/plugins/terminal/data.json

# Spaced-repetition data.json IS tracked on purpose: it is review progress.
# Sweep it into commits with scripts/restore-obsidian.sh --backup.

# Offline copy of the book; too big for the repo
learn-go-with-tests.pdf

# Personal opencode config backup; keep tool config out of the repo
opencode.json.bak
